{
  "$id": "urn:codex-wire-audit:schema:source:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "available": {
      "type": "boolean"
    },
    "byte_length": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "encoding": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_blob_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "pattern": "^source\\.",
      "type": "string"
    },
    "line_count": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "roles": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "path",
    "available"
  ],
  "title": "Codex wire audit source record",
  "type": "object"
}
