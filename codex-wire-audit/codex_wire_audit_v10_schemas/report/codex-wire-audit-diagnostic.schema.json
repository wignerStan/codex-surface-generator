{
  "$id": "urn:codex-wire-audit:schema:diagnostic:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "category": {
      "type": "string"
    },
    "code": {
      "pattern": "^[A-Z0-9_]+$",
      "type": "string"
    },
    "id": {
      "pattern": "^diagnostic\\.",
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "recoverable": {
      "type": "boolean"
    },
    "report_pointers": {
      "items": {
        "pattern": "^/",
        "type": "string"
      },
      "type": "array"
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "strict_failure": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "code",
    "severity",
    "category",
    "message",
    "report_pointers"
  ],
  "title": "Codex wire audit diagnostic",
  "type": "object"
}
