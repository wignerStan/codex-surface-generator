{
  "$id": "https://openai.example/codex-wire-audit/proof-attestation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "required": [
          "report_sha256",
          "coverage_profile",
          "dimensions",
          "rust_semantics",
          "provenance",
          "runtime_conformance",
          "diagnostic_summary"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "properties": {
              "overall": {
                "const": "error"
              }
            }
          }
        }
      },
      "then": {}
    }
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "coverage_profile": {
      "type": "object"
    },
    "diagnostic_summary": {
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "dimensions": {
      "type": "object"
    },
    "format": {
      "const": "codex-wire-audit-proof-attestation/v1"
    },
    "generated_at": {
      "type": "string"
    },
    "integrity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonical_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "canonical_payload_sha256"
      ],
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_conformance": {
      "type": "object"
    },
    "rust_semantics": {
      "type": "object"
    },
    "schema_id": {
      "const": "https://openai.example/codex-wire-audit/proof-attestation-v1.schema.json"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "incomplete_dimensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "overall": {
          "enum": [
            "complete",
            "incomplete",
            "error"
          ]
        },
        "required_dimensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "overall",
        "complete"
      ],
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schema_id",
    "format",
    "generated_at",
    "status",
    "diagnostics",
    "integrity"
  ],
  "title": "Codex wire audit proof attestation v1",
  "type": "object"
}
